{
  "title": "M.U.M.N.K8s MONITORING DASHBOARD",
  "uid": "mumnk8s-main",
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["mumnk8s"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "title": "Máx. Aviones en Aire (Global)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGET stats max_planes",
        "type": "command"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 30 }, { "color": "red", "value": 45 }] } } }
    },
    {
      "id": 2,
      "title": "Mín. Aviones en Aire (Global)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGET stats min_planes",
        "type": "command"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 3,
      "title": "Máx. Barcos en Mar (Global)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGET stats max_ships",
        "type": "command"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 27 }] } } }
    },
    {
      "id": 4,
      "title": "Mín. Barcos en Mar (Global)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGET stats min_ships",
        "type": "command"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 5,
      "title": "Moda Aviones en Aire",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGET stats mode_planes",
        "type": "command"
      }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "title": "Moda Barcos en Mar",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGET stats mode_ships",
        "type": "command"
      }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "title": "País Asignado",
      "type": "text",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "datasource", "uid": "-- Dashboard --" },
      "targets": [],
      "options": { "mode": "markdown", "content": "# 🇷🇺 RUS\n### Russia\n*País asignado (carnet termina en 2)*" },
      "transparent": false
    },
    {
      "id": 8,
      "title": "Total Reportes Recibidos de RUS",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGET reports:count RUS",
        "type": "command"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 9,
      "title": "Top Países - Aviones en Aire",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGETALL top:planes:hash",
        "type": "command"
      }],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } },
      "transformations": [
        { "id": "convertFieldTypes", "options": { "conversions": [{ "targetField": "Value", "destinationType": "number" }] } }
      ]
    },
    {
      "id": 10,
      "title": "Top Países - Barcos en Mar",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "HGETALL top:ships:hash",
        "type": "command"
      }],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "showUnfilled": true },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } },
      "transformations": [
        { "id": "convertFieldTypes", "options": { "conversions": [{ "targetField": "Value", "destinationType": "number" }] } }
      ]
    },
    {
      "id": 11,
      "title": "Serie Temporal RUS - Aviones y Barcos en Mar",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "redis-datasource", "uid": "valkey" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "redis-datasource", "uid": "valkey" },
        "query": "XRANGE series:RUS - + COUNT 500",
        "type": "command",
        "streaming": false
      }],
      "options": { "tooltip": { "mode": "multi", "sort": "none" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "planes" },
            "properties": [
              { "id": "displayName", "value": "Aviones RUS" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ships" },
            "properties": [
              { "id": "displayName", "value": "Barcos RUS" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "convertFieldTypes",
          "options": {
            "conversions": [
              { "targetField": "planes", "destinationType": "number" },
              { "targetField": "ships", "destinationType": "number" }
            ]
          }
        }
      ]
    }
  ]
}
